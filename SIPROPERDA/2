let questionNumber = 1;
const questionsContainer = document.querySelector('#survey-questions');

surveyGroups.forEach((group) => {
  const groupElement = document.createElement('fieldset');
  groupElement.className = 'survey-group';
  groupElement.innerHTML = `<legend>${group.title}</legend>`;

  group.questions.forEach((question) => {
    const currentNumber = questionNumber;
    const questionElement = document.createElement('div');
    questionElement.className = 'survey-question';

    const options = [1, 2, 3, 4, 5]
      .map((value) => `
        <input id="q${currentNumber}-${value}" name="q${currentNumber}" type="radio" value="${value}" />
        <label for="q${currentNumber}-${value}" aria-label="Nilai ${value}">${value}</label>
      `)
      .join('');

    questionElement.innerHTML = `
      <span>${currentNumber}. ${question}</span>
      <div class="rating-options" aria-label="Nilai pertanyaan ${currentNumber}">${options}</div>
    `;
    groupElement.appendChild(questionElement);
    questionNumber += 1;
  });

  questionsContainer.appendChild(groupElement);
});

